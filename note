#!/usr/bin/env python3
"""A tiny content-addressed note CLI."""

import hashlib
import os
import sys
from pathlib import Path

DB_DIR = Path(os.environ.get("NOTE_DB_DIR", ".notes/db"))


def note_hash(content: str) -> str:
    return hashlib.sha256(content.encode("utf-8")).hexdigest()


def add(content: str) -> int:
    DB_DIR.mkdir(parents=True, exist_ok=True)
    digest = note_hash(content)
    path = DB_DIR / digest
    # The content is stored exactly as supplied, without adding a newline.
    if not path.exists():
        path.write_text(content, encoding="utf-8")
    print(digest)
    return 0


def delete(digest: str) -> int:
    # Accept only SHA-256 hex digests to prevent path traversal.
    if len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest):
        print("error: hash must be a 64-character lowercase SHA-256 hex digest", file=sys.stderr)
        return 2
    path = DB_DIR / digest
    try:
        path.unlink()
    except FileNotFoundError:
        print(f"error: note not found: {digest}", file=sys.stderr)
        return 1
    print(digest)
    return 0


def usage() -> None:
    print(
        "Usage:\\n"
        "  note add <text>\\n"
        "  note list\\n"
        "  note delete <hash>",
        file=sys.stderr,
    )


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if not argv:
        usage()
        return 2

    command, *args = argv
    if command == "add":
        if not args:
            usage()
            return 2
        return add(" ".join(args))
    if command == "delete":
        if len(args) != 1:
            usage()
            return 2
        return delete(args[0])

    usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
